{
  "$schema": "https://raw.githubusercontent.com/casonadams/permission/main/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": { "action": "deny", "reason": "secrets" },
      "*.env.*": { "action": "deny", "reason": "secrets" },
      "*.env.example": "allow",
      "~/.ssh/*": { "action": "deny", "reason": "secrets" }
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "rm -rf *": { "action": "deny", "reason": "destructive" },
      "sudo *": "ask"
    }
  }
}