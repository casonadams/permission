{
  "$schema": "https://raw.githubusercontent.com/casonadams/permission/main/schemas/permissions.schema.json",
  "permission": {
    "*": "ask",
    "path": {
      "/tmp/*": "allow",
      "*.env*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": { "action": "deny", "reason": "destructive" },
      "sudo *": "ask"
    }
  }
}
